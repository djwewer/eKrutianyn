generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JUNAK
  VYKHOVNYK
  ZVYAZKOVYI
}

enum PositionScope {
  KURIN
  HURTOK
}

enum PositionType {
  KURINNYI
  SUDDIA
  PYSAR
  SKARBNYK
  INTENDANT
  KHORUNZHYI
  SMM
  HURTKOVYI
}

enum KurinGender {
  MALE
  FEMALE
}

enum ProbyProgramVersion {
  OLD
  NEW
}

enum ProgressStatus {
  NOT_DONE
  DONE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalActionType {
  CHANGE_FULL_NAME
  CHANGE_BIRTH_DATE
  CHANGE_EMAIL
  CHANGE_HURTOK
  CREATE_JUNAK
  BULK_IMPORT_JUNAKY
  ARCHIVE_JUNAK
}

model Kurin {
  id                           String       @id @default(uuid())
  name                         String
  // Null until the КПС assigns a permanent number after the preparatory
  // period (Правильник УПЮ, 4.2.5) — a preparatory kurin genuinely has no
  // number yet, so this is never backfilled with a synthetic placeholder.
  kurinNumber                  String?      @unique
  gender                       KurinGender
  stanytsia                    String
  probyProgramId               String
  probyProgram                 ProbyProgram @relation(fields: [probyProgramId], references: [id])
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  driveFolderId                String?
  driveFolderName              String?
  driveRefreshToken            String?
  driveConnectedEmail          String?
  driveConnectedAt             DateTime?
  judgeBookSpreadsheetId       String?
  judgeBookSpreadsheetName     String?
  // The treasurer's manually-entered "current cash on hand" baseline when
  // they start using Скарбництво — not synced from anywhere (Google Sheets
  // linking is a deliberate later addition, not part of this feature).
  // Current balance = this + sum(INCOME) - sum(EXPENSE) transactions.
  treasuryStartingBalanceCents Int          @default(0)

  hurtky               Hurtok[]
  inventoryItems       InventoryItem[]
  users                User[]
  positions            KurinPosition[]
  junakImportMapping   JunakImportMapping?
  treasuryTransactions TreasuryTransaction[]
  calendarEvents       KurinCalendarEvent[]
  announcements        Announcement[]
  announcementImages   AnnouncementImage[]
  auditLogs            AuditLog[]
  skills               Skill[]
}

model JunakImportMapping {
  id                   String   @id @default(uuid())
  kurinId              String   @unique
  kurin                Kurin    @relation(fields: [kurinId], references: [id])
  columnMapping        Json
  positionValueMapping Json
  updatedAt            DateTime @updatedAt
}

model Hurtok {
  id           String    @id @default(uuid())
  kurinId      String
  kurin        Kurin     @relation(fields: [kurinId], references: [id])
  name         String
  slug         String?
  number       String?
  foundedAt    DateTime?
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("HurtokArchivedBy", fields: [archivedById], references: [id])

  junaky               User[]            @relation("JunakHurtok")
  vykhovnykAssignments VykhovnykHurtok[]
  positions            KurinPosition[]
}

model User {
  id                 String    @id @default(uuid())
  firstName          String
  lastName           String
  nickname           String?
  email              String    @unique
  passwordHash       String?
  // True when someone else (admin/zvyazkovyi/kurinniy) assigned this
  // account's current password on its behalf — forces a change on next
  // login. Cleared whenever the user sets a password themselves.
  mustChangePassword Boolean   @default(false)
  googleId           String?   @unique
  role               Role
  birthDate          DateTime?
  notes              String?
  phone              String?
  // Книга судді fields the book tracks per junak.
  residence          String?
  studyPlace         String?
  // Date the junak earned the "Скоб" degree. Unlike the three proby degrees
  // (derived from closed ProbyStages) there is no proby behind it, so the
  // date is entered by hand.
  skobDate           DateTime?
  judgeBookRowNumber Int?
  photoData          Bytes?
  photoMimeType      String?
  photoUpdatedAt     DateTime?
  kurinId            String
  kurin              Kurin     @relation(fields: [kurinId], references: [id])
  hurtokId           String?
  hurtok             Hurtok?   @relation("JunakHurtok", fields: [hurtokId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?
  archivedById       String?
  archivedBy         User?     @relation("UserArchivedBy", fields: [archivedById], references: [id])
  archivedUsers      User[]    @relation("UserArchivedBy")
  hurtokArchivedByMe Hurtok[]  @relation("HurtokArchivedBy")

  vykhovnykAssignments       VykhovnykHurtok[]      @relation("VykhovnykAssignments")
  progressEntries            JunakProgress[]        @relation("JunakProgressEntries")
  confirmedProgress          JunakProgress[]        @relation("ConfirmedByUser")
  auditLogEntries            AuditLog[]             @relation("ActorAuditLogs")
  initiatedRequests          ApprovalRequest[]      @relation("InitiatedRequests")
  decidedRequests            ApprovalRequest[]      @relation("DecidedRequests")
  passwordResetTokens        PasswordResetToken[]
  emailChangeRequests        EmailChangeRequest[]
  profileChangeLogs          ProfileChangeLog[]
  positionsHeld              KurinPosition[]        @relation("PositionHolder")
  positionsAssigned          KurinPosition[]        @relation("PositionAssignedBy")
  positionsRemoved           KurinPosition[]        @relation("PositionRemovedBy")
  guardianContacts           GuardianContact[]      @relation("JunakGuardians")
  createdInventoryItems      InventoryItem[]
  stageProgressEntries       JunakStageProgress[]   @relation("JunakStageProgressEntries")
  stageClosedLogs            JunakStageProgress[]   @relation("StageClosedByUser")
  aiConversations            AiConversation[]
  treasuryTransactions       TreasuryTransaction[]
  calendarEvents             KurinCalendarEvent[]
  activityEntries            JunakActivityEntry[]   @relation("JunakActivityEntries")
  authoredAnnouncements      Announcement[]
  uploadedAnnouncementImages AnnouncementImage[]
  announcementReactions      AnnouncementReaction[]
  pushSubscriptions          PushSubscription[]
  junakSkills                JunakSkill[]           @relation("JunakSkills")
  createdJunakSkills         JunakSkill[]           @relation("JunakSkillCreatedBy")
}

model KurinPosition {
  id           String        @id @default(uuid())
  kurinId      String
  kurin        Kurin         @relation(fields: [kurinId], references: [id])
  hurtokId     String?
  hurtok       Hurtok?       @relation(fields: [hurtokId], references: [id])
  scope        PositionScope
  positionType PositionType
  userId       String
  user         User          @relation("PositionHolder", fields: [userId], references: [id])
  assignedAt   DateTime      @default(now())
  assignedById String
  assignedBy   User          @relation("PositionAssignedBy", fields: [assignedById], references: [id])
  removedAt    DateTime?
  removedById  String?
  removedBy    User?         @relation("PositionRemovedBy", fields: [removedById], references: [id])
}

model InventoryItem {
  id          String   @id @default(uuid())
  kurinId     String
  kurin       Kurin    @relation(fields: [kurinId], references: [id])
  name        String
  description String?
  quantity    Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos InventoryItemPhoto[]
}

model InventoryItemPhoto {
  id          String        @id @default(uuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  driveFileId String
  url         String
  createdAt   DateTime      @default(now())
}

enum TreasuryTransactionType {
  INCOME
  EXPENSE
}

model TreasuryTransaction {
  id          String                  @id @default(uuid())
  kurinId     String
  kurin       Kurin                   @relation(fields: [kurinId], references: [id])
  type        TreasuryTransactionType
  amountCents Int
  description String
  occurredAt  DateTime
  createdById String
  createdBy   User                    @relation(fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([kurinId, occurredAt])
}

model KurinCalendarEvent {
  id          String    @id @default(uuid())
  kurinId     String
  kurin       Kurin     @relation(fields: [kurinId], references: [id])
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kurinId, startDate])
}

enum JunakActivityRole {
  PARTICIPANT
  PROVID
}

model JunakActivityEntry {
  id          String            @id @default(uuid())
  junakId     String
  junak       User              @relation("JunakActivityEntries", fields: [junakId], references: [id])
  title       String
  occurredAt  DateTime
  role        JunakActivityRole
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([junakId, occurredAt])
}

enum SkillGroup {
  PRACTICAL // Вмілості практичного пластування
  FIRST_AID // Вмілості першої допомоги і рятівництва
  NATURE    // Природничі вмілості
  SPORT     // Спортивні вмілості
  HOME      // Вмілості домашньої зарадності
  SPECIAL   // Вмілості спеціального зацікавлення
  ARTS      // Мистецькі вмілості
  AVIATION  // Вмілості літунського пластування
  SEA       // Вмілості морського пластування
}

model Skill {
  id        String       @id @default(uuid())
  // null = глобальний каталог («Вмілості УПЮ», 2003, сид); не null = власна вмілість куреня.
  kurinId   String?
  // Restrict: SetNull (типовий для опціонального звʼязку) зробив би власні
  // вмілості видаленого куреня «глобальними».
  kurin     Kurin?       @relation(fields: [kurinId], references: [id], onDelete: Restrict)
  name      String
  group     SkillGroup
  createdAt DateTime     @default(now())
  levels    SkillLevel[]

  // Унікальність власних назв у межах куреня. Для глобальних (kurinId IS NULL)
  // Postgres вважає NULL різними, тож унікальність їхніх назв забезпечує
  // частковий індекс "Skill_global_name_key" з міграції *_junak_skills —
  // Prisma не вміє описати його в схемі. Якщо `prisma migrate dev` колись
  // згенерує `DROP INDEX "Skill_global_name_key"`, приберіть цей рядок з міграції.
  @@unique([kurinId, name])
}

model SkillLevel {
  id           String       @id @default(uuid())
  skillId      String
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // 1, 2, 3 = перша / друга / третя проба, до якої призначена вмілість.
  level        Int
  // Упорядковані вимоги: [{ text: string, items?: string[] }] — SkillRequirement
  // у src/skills/skill.types.ts (items — підпункти а/б/в).
  requirements Json
  // Примітка рівня: «Виконати вимоги А або Б.», «нова вмілість».
  note         String?
  achievements JunakSkill[]

  @@unique([skillId, level])
}

model JunakSkill {
  id                String     @id @default(uuid())
  junakId           String
  junak             User       @relation("JunakSkills", fields: [junakId], references: [id])
  levelId           String
  // Restrict (типово для обовʼязкового звʼязку): рівень зі здобуттями не видаляється.
  level             SkillLevel @relation(fields: [levelId], references: [id])
  achievedAt        DateTime   @db.Date
  // Імʼя екзаменатора вільним текстом (може бути непластун).
  examiner          String?
  certificateNumber String?
  createdById       String
  createdBy         User       @relation("JunakSkillCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime   @default(now())

  @@unique([junakId, levelId])
  @@index([junakId])
}

enum GuardianRelation {
  MOTHER
  FATHER
  GUARDIAN
}

model GuardianContact {
  id        String   @id @default(uuid())
  junakId   String
  junak     User     @relation("JunakGuardians", fields: [junakId], references: [id])
  name      String
  phone     String
  // Free-text clarification, meaningful for relation = GUARDIAN ("бабуся",
  // "тітка"...). MOTHER / FATHER are the standard two; anything else is a
  // GUARDIAN.
  role      String?
  relation  GuardianRelation @default(GUARDIAN)
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VykhovnykHurtok {
  id          String @id @default(uuid())
  vykhovnykId String
  vykhovnyk   User   @relation("VykhovnykAssignments", fields: [vykhovnykId], references: [id])
  hurtokId    String
  hurtok      Hurtok @relation(fields: [hurtokId], references: [id])

  @@unique([vykhovnykId, hurtokId])
}

model ProbyProgram {
  id      String              @id @default(uuid())
  version ProbyProgramVersion
  name    String

  stages ProbyStage[]
  kuriny Kurin[]
}

model ProbyStage {
  id        String       @id @default(uuid())
  programId String
  program   ProbyProgram @relation(fields: [programId], references: [id])
  order     Int
  name      String

  categories           ProbyCategory[]
  stageProgressEntries JunakStageProgress[]
}

model ProbyCategory {
  id      String     @id @default(uuid())
  stageId String
  stage   ProbyStage @relation(fields: [stageId], references: [id])
  name    String

  points ProbyPoint[]
}

model ProbyPoint {
  id            String        @id @default(uuid())
  categoryId    String
  category      ProbyCategory @relation(fields: [categoryId], references: [id])
  order         Int
  description   String
  // Curated factual material (dates, names, specifics) for the AI-виховник's
  // system prompt — kept separate from `description` so a short official label
  // can coexist with a longer reference text, and so a point without curated
  // content just falls back to grounding on `description` alone.
  referenceText String?       @db.Text

  progressEntries    JunakProgress[]   @relation("PointProgress")
  transferredEntries JunakProgress[]   @relation("TransferredFromPoint")
  mappingsAsOld      PointMapping[]    @relation("OldPoint")
  mappingsAsNew      PointMapping[]    @relation("NewPoint")
  aiMessages         AiMessage[]
  aiConversations    AiConversation[]
  referenceSources   ReferenceSource[]
}

// A web page the AI-виховник grounds its answers in, refreshed on a weekly
// cron instead of fetched live per chat message (cheaper, no new per-message
// failure mode, and the cached text survives the source site being briefly
// down). probyPointId is optional: a source can stand on its own (e.g. a
// specific song page) and be found by label/URL rather than tied to one
// catalog point.
model ReferenceSource {
  id            String      @id @default(uuid())
  url           String
  label         String
  probyPointId  String?
  probyPoint    ProbyPoint? @relation(fields: [probyPointId], references: [id])
  extractedText String?     @db.Text
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([probyPointId])
}

model PointMapping {
  id         String     @id @default(uuid())
  oldPointId String
  oldPoint   ProbyPoint @relation("OldPoint", fields: [oldPointId], references: [id])
  newPointId String
  newPoint   ProbyPoint @relation("NewPoint", fields: [newPointId], references: [id])

  @@unique([oldPointId, newPointId])
}

model JunakProgress {
  id                     String         @id @default(uuid())
  junakId                String
  junak                  User           @relation("JunakProgressEntries", fields: [junakId], references: [id])
  pointId                String
  point                  ProbyPoint     @relation("PointProgress", fields: [pointId], references: [id])
  status                 ProgressStatus @default(NOT_DONE)
  confirmedById          String?
  confirmedBy            User?          @relation("ConfirmedByUser", fields: [confirmedById], references: [id])
  confirmedAt            DateTime?
  transferredFromPointId String?
  transferredFromPoint   ProbyPoint?    @relation("TransferredFromPoint", fields: [transferredFromPointId], references: [id])

  @@unique([junakId, pointId])
}

model JunakStageProgress {
  id            String     @id @default(uuid())
  junakId       String
  junak         User       @relation("JunakStageProgressEntries", fields: [junakId], references: [id])
  stageId       String
  stage         ProbyStage @relation(fields: [stageId], references: [id])
  firstClosedAt DateTime?
  closedAt      DateTime?
  closedById    String?
  closedBy      User?      @relation("StageClosedByUser", fields: [closedById], references: [id])

  @@unique([junakId, stageId])
}

model ApprovalRequest {
  id            String             @id @default(uuid())
  initiatedById String
  initiatedBy   User               @relation("InitiatedRequests", fields: [initiatedById], references: [id])
  junakId       String?
  actionType    ApprovalActionType
  oldData       Json?
  newData       Json
  status        ApprovalStatus     @default(PENDING)
  approvedById  String?
  approvedBy    User?              @relation("DecidedRequests", fields: [approvedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailChangeRequest {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProfileChangeLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  // Each conversation is pinned to one proby point: picking a different point
  // in the AI-виховник UI switches to that point's own conversation instead of
  // mixing topics into one chat. Nullable only because conversations created
  // before this field existed have no point to backfill; a brand new
  // conversation always sets it.
  probyPointId String?
  probyPoint   ProbyPoint? @relation(fields: [probyPointId], references: [id])
  title        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AiMessage[]

  @@unique([userId, probyPointId])
  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  role           AiMessageRole
  content        String         @db.Text
  probyPointId   String?
  probyPoint     ProbyPoint?    @relation(fields: [probyPointId], references: [id])
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model Announcement {
  id        String   @id @default(uuid())
  kurinId   String
  kurin     Kurin    @relation(fields: [kurinId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    AnnouncementImage[]
  reactions AnnouncementReaction[]

  @@index([kurinId, createdAt])
}

// Nullable announcementId: an image is uploaded during composition, before
// the announcement it belongs to exists — linked only once the writer
// actually publishes (POST/PATCH .../announcements with imageIds).
model AnnouncementImage {
  id             String        @id @default(uuid())
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  kurinId        String
  kurin          Kurin         @relation(fields: [kurinId], references: [id])
  uploaderId     String
  uploader       User          @relation(fields: [uploaderId], references: [id])
  data           Bytes
  mimeType       String
  createdAt      DateTime      @default(now())
}

enum ReactionEmoji {
  THUMBS_UP
  HEART
  CLAP
  WOW
  LAUGH
  SAD
}

model AnnouncementReaction {
  id             String        @id @default(uuid())
  announcementId String
  announcement   Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  emoji          ReactionEmoji
  createdAt      DateTime      @default(now())

  @@unique([announcementId, userId])
}

// One row per subscribed browser/device (the Web Push PushSubscription
// object), not per user — the same user can have several (phone + laptop).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuditAction {
  // Проба
  PROBY_POINT_CONFIRMED
  PROBY_POINT_UNCONFIRMED
  PROBY_STAGE_CLOSED
  PROBY_STAGE_REOPENED
  DEGREE_DATE_CHANGED
  // Люди й ролі
  USER_CREATED
  USER_ARCHIVED
  USER_CONTACT_UPDATED
  USER_HURTOK_CHANGED
  POSITION_ASSIGNED
  POSITION_REMOVED
  HURTOK_CREATED
  HURTOK_UPDATED
  HURTOK_ARCHIVED
  VYKHOVNYK_ASSIGNED
  VYKHOVNYK_UNASSIGNED
  GUARDIAN_CREATED
  GUARDIAN_UPDATED
  GUARDIAN_DELETED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  // Гроші й майно
  TREASURY_TRANSACTION_CREATED
  TREASURY_TRANSACTION_DELETED
  TREASURY_STARTING_BALANCE_CHANGED
  INVENTORY_ITEM_CREATED
  INVENTORY_ITEM_UPDATED
  INVENTORY_ITEM_DELETED
  INVENTORY_PHOTO_ADDED
  INVENTORY_PHOTO_REMOVED
  // Налаштування та інтеграції
  KURIN_PROBY_PROGRAM_CHANGED
  DRIVE_CONNECTED
  DRIVE_DISCONNECTED
  DRIVE_FOLDER_SET
  JUDGE_BOOK_CONNECTED
  JUDGE_BOOK_IMPORTED
  JUDGE_BOOK_SYNCED
  JUDGE_BOOK_SYNCED_NIGHTLY
  APD_CREATED
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_UPDATED
  ANNOUNCEMENT_DELETED
  // Історія юнака
  SKILL_ACHIEVED
  SKILL_UPDATED
  SKILL_REMOVED
  CUSTOM_SKILL_CREATED
  CUSTOM_SKILL_UPDATED
  CUSTOM_SKILL_DELETED
}

model AuditLog {
  id            String      @id @default(uuid())
  kurinId       String
  kurin         Kurin       @relation(fields: [kurinId], references: [id])
  // null = системна дія (cron)
  actorId       String?
  actor         User?       @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action        AuditAction
  subjectUserId String?
  entityId      String?
  details       Json?
  createdAt     DateTime    @default(now())

  @@index([kurinId, createdAt, id])
  @@index([kurinId, subjectUserId])
  @@index([kurinId, action])
}
