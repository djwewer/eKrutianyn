DATABASE_URL="postgresql://plast:plast@localhost:5432/plast_dev"
DATABASE_URL_TEST="postgresql://plast:plast@localhost:5432/plast_test"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1d"
GOOGLE_CLIENT_ID=""
ADMIN_API_KEY="dev-admin-key-change-me"
# Second, independent factor required alongside ADMIN_API_KEY to use any
# /admin/* endpoint — both must be correct.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="dev-admin-password-change-me"
PORT=3001
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
FRONTEND_URL="http://localhost:3000"
MAIL_MODE=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/kurins/google-drive/callback"
# AI-виховник chat assistant — targets the real OpenAI API by default.
# To use an OpenAI-compatible provider instead, set OPENAI_BASE_URL and put
# that provider's key/model here, e.g.:
#   Groq:
#     OPENAI_API_KEY="gsk_..."
#     OPENAI_BASE_URL="https://api.groq.com/openai/v1"
#     OPENAI_MODEL="llama-3.3-70b-versatile"
#   Gemini (base URL must end with the trailing slash — the SDK appends /chat/completions):
#     OPENAI_API_KEY="<Gemini API key from aistudio.google.com>"
#     OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#     OPENAI_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY="sk-replace-me"
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o"
# When OPENAI_BASE_URL points at Gemini, the assistant also gets live Google
# Search grounding (the model decides per-turn whether it needs to search —
# not on every message), called via Gemini's native API since Google Search
# grounding isn't available through the OpenAI-compatibility endpoint. This
# bills per search query on top of normal token costs; set to "false" to
# disable it without changing OPENAI_BASE_URL.
GEMINI_SEARCH_GROUNDING="true"
# Two caps on JUNAK use of the AI-виховник, so one junak can't burn through
# a kurin's whole daily token/search budget. ZVYAZKOVYI is never limited.
# - new conversations a JUNAK can start per rolling 24h window
AI_ASSISTANT_JUNAK_DAILY_NEW_CHAT_LIMIT="5"
# - user messages ("edits") allowed within a single conversation
AI_ASSISTANT_JUNAK_MESSAGES_PER_CHAT_LIMIT="5"
# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# The public key also gets exposed to the frontend as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (apps/web) — same value, different env file.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
