API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ADMIN_API_KEY=dev-admin-key
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Cloud project NUMBER (not project ID) of the project owning GOOGLE_OAUTH_CLIENT_ID —
