API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ADMIN_API_KEY=dev-admin-key
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Cloud project NUMBER (not project ID) of the project owning GOOGLE_OAUTH_CLIENT_ID —
# required for the Picker to grant the drive.file-scoped token access to a picked item.
# Find it on the GCP Console dashboard for that project ("Project number").
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=
# Same value as the API's VAPID_PUBLIC_KEY (apps/api/.env) — the public half
# of the Web Push VAPID key pair, safe to expose client-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
